// use prisma-8

model User {
  id           String   @id @default(cuid(2))
  username     String   @unique
  displayName  String
  passwordHash String
  role         String   @default("user")
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model AuthSession {
  id        String   @id @default(cuid(2))
  tokenHash String   @unique
  userId    String
  createdAt TimestamptzString @default(now())
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid(2))
  username  String
  userId    String?
  eventType String
  source    String
  occurredAt TimestamptzString @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, eventType, occurredAt])
  @@index([userId, occurredAt])
}

model CryptoIdentity {
  userId      String   @id
  publicKey   String
  fingerprint String   @unique
  createdAt   TimestamptzString @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecureMessage {
  id          String   @id @default(cuid(2))
  senderId    String
  recipientId String
  version     Int      @default(1)
  ciphertext  String
  iv          String
  senderWrappedKey    String
  recipientWrappedKey String
  createdAt           TimestamptzString @default(now())
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model SecureFile {
  id                  String   @id @default(cuid(2))
  senderId            String
  recipientId         String
  version             Int      @default(1)
  ciphertext          Bytes
  ciphertextBytes     Int
  iv                  String
  senderWrappedKey    String
  recipientWrappedKey String
  createdAt           TimestamptzString @default(now())
  sender              User     @relation("FileSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient           User     @relation("FileRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}
