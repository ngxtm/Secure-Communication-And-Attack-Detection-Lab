# Local Docker Compose values. Use long, unique values and keep .env private.
POSTGRES_DB=network_security_lab
POSTGRES_USER=network_security
POSTGRES_PASSWORD=replace_with_a_long_alphanumeric_secret

# Required demo account credentials; replace before first start.
SEED_ALICE_PASSWORD=replace_with_a_unique_password_at_least_20_chars
SEED_BOB_PASSWORD=replace_with_a_different_password_at_least_20_chars

# Local Compose runs over HTTP. Set true behind HTTPS (for example, Dokploy).
SESSION_COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
API_INTERNAL_URL=http://api:3000

WEB_PORT=3000
API_PORT=4000
